# Redis Connection Configuration (Upstash or local)
# Use rediss:// prefix for Upstash Redis TLS connection
REDIS_URL=redis://127.0.0.1:6379

# MongoDB Connection Configuration
MONGO_URI=mongodb://username:password@cluster.mongodb.net/database_name

# Worker Server Settings
PORT=3001
NODE_ENV=production
IS_WORKER=true

# Bull Board Dashboard Basic Auth Credentials
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=secure_password_here

# Mailer (nodemailer) Configuration
GMAIL_USER=umangvisionacademy@gmail.com
GMAIL_APP_PASSWORD=gmail_app_specific_password_here
CLIENT_URL=https://umang-vision-academy.vercel.app

# SMS Gateways (Fast2SMS / Twilio)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_OTP_ID=your_fast2sms_otp_id_here
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_sid_here
